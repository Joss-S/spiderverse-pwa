# Copia este archivo a .env y rellena tus valores.
# NUNCA subas .env a GitHub (contiene la clave privada VAPID).

PORT=4000
VAPID_SUBJECT=mailto:admin@spiderverse.local

# Par de claves VAPID (la pública debe ser la misma que usa la app Angular).
VAPID_PUBLIC_KEY=tu_clave_publica_vapid
VAPID_PRIVATE_KEY=tu_clave_privada_vapid

# Origen(es) permitidos por CORS, separados por comas.
# En local: http://localhost:4000,http://localhost:4200
# En producción: https://tu-app.vercel.app
CORS_ORIGIN=http://localhost:4000
